local function addSlider(parent, label, min, max, default, cb)
    local r = row(parent, 54)
    local t = mk("TextLabel", { Size=UDim2.new(1,-24,0,18), Position=UDim2.new(0,12,0,6),
        BackgroundTransparency=1, Text=label..": "..tostring(default), TextColor3=C.text,
        Font=Enum.Font.GothamMedium, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left }, r)
    local track = mk("Frame", { Size=UDim2.new(1,-24,0,8), Position=UDim2.new(0,12,0,36),
        BackgroundColor3=C.off, BorderSizePixel=0 }, r)
    corner(track, 4)
    local fill = mk("Frame", { Size=UDim2.new((default-min)/(max-min),0,1,0),
        BackgroundColor3=C.accent, BorderSizePixel=0 }, track)
    corner(fill, 4)
    local hit = mk("TextButton", { Size=UDim2.new(1,-24,0,26), Position=UDim2.new(0,12,0,27),
        BackgroundTransparency=1, Text="" }, r)
    local val, dragging = default, false
    local function upd(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X,1), 0, 1)
        val = math.floor(min + rel * (max - min) + 0.5)
        fill.Size = UDim2.new(rel,0,1,0)
        t.Text = label..": "..tostring(val)
        if cb then task.spawn(cb, val) end
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; upd(i) end
    end)
    bind(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement) then upd(i) end
    end))
    bind(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end))
    return { get = function() return val }
end
