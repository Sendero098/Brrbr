function dop(p)
    pcall(function()
        if p.Name:find("PromptAttachment") and p:FindFirstChild("ProximityPrompt") then
            local c = p.ProximityPrompt
            table.insert(pp, c)
            if ipp then c.HoldDuration = 0 end
            table.insert(tableofconnections, c:GetPropertyChangedSignal("HoldDuration"):Connect(function()
                if c.HoldDuration ~= 0 and ipp then c.HoldDuration = 0 end
            end))
        end
    end)
end

