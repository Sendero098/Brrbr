local function diagnose()
    local L = {}
    local function out(s) table.insert(L, s) end
    out("=== VENICE HUB DIAG v4.1 ===")
    out("time      = " .. os.date("%H:%M:%S"))
    out("place     = " .. tostring(game.PlaceId))
    out("job       = " .. tostring(game.JobId))
    out("BYPASS    = armed x" .. tostring(BYP.armed) .. "  connMt=" .. tostring(BYP.connMt ~= nil)
        .. "  tagged=" .. tostring(BYP.tagCount))
    out("executor  = getgc:" .. tostring(getgc ~= nil) .. " hookfn:" .. tostring(hookfunction ~= nil)
        .. " ncc:" .. tostring(newcclosure ~= nil) .. " rawmt:" .. tostring(getrawmetatable ~= nil))
    out("lastKick  = " .. tostring(lastKick))
    out("gui parent= " .. (GUI and GUI.Parent and GUI.Parent:GetFullName() or "none"))
    out("plots     = " .. #getPlots())
    out("myplot    = " .. (getMyPlot() and "yes" or "NO"))
    local targets = scanTargets(false)
    out("stealable = " .. #targets)
    for i = 1, math.min(6, #targets) do
        out(string.format("  %d. %-28s $%d", i, targets[i].name, math.floor(targets[i].value)))
    end
    out("--- log tail ---")
    pcall(function()
        local d = readfile and readfile(LOGF)
        if d then
            local lines = {}
            for l in d:gmatch("[^\n]+") do table.insert(lines, l) end
            for i = math.max(1, #lines - 25), #lines do out("  " .. lines[i]) end
        end
    end)
    out("=== END ===")
    return table.concat(L, "\n")
end
local function showDiag()
    local ok, txt = pcall(diagnose)
    if not ok then txt = "diag error: " .. tostring(txt) end
    if diagLabel then diagLabel.Text = txt end
    pcall(function() if setclipboard then setclipboard(txt) end end)
    log("diag shown")
end

