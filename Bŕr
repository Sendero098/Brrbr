task.spawn(function()
    while alive() do
        task.wait(15)
        if not obsHooked then armObserveTag() end
    end
end)

local st = loadHop()
if st and st.auto then
    task.spawn(function()
        task.wait(15)
        if not alive() then return end
        local best = bestInServer()
        if best and best.value >= (st.target or 0) then
            saveHop(nil)
            log("FOUND " .. best.name .. " $" .. math.floor(best.value))
            if S.autoSteal then startAutoSteal() end
        else
            doHop(st)
        end
    end)
end

