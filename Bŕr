local function refreshBrainrotESP()
    local live = {}
    local my = getMyPlot()
    for _, plot in ipairs(getPlots()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, pod in ipairs(podiums:GetChildren()) do
                local prompt = getPrompt(pod)
                if prompt then
                    local model = findBrainrotModel(pod)
                    if model then
                        live[model] = true
                        makeBrainrotESP(model, prompt.ObjectText)
                        local d = brESP[model]
                        if d then
                            if d.hl.Parent ~= ensureEspFolder() then d.hl.Parent = ensureEspFolder() end
                            local val = getValue(pod) + getValue(model)
                            local tag = (plot == my) and "MINE" or "STEAL"
                            d.txt.Text = string.format("%s\n%s  %s", prompt.ObjectText,
                                tag, val > 0 and ("$" .. tostring(math.floor(val))) or "")
                            d.txt.TextColor3 = (plot == my) and ESP_GOOD or Color3.new(1,1,1)
                            d.hl.FillColor = (plot == my) and ESP_GOOD or ESP_FILL
                            d.hl.OutlineColor = d.hl.FillColor
                        end
                    end
                end
            end
        end
    end
    for m, d in pairs(brESP) do
        if not live[m] or not m.Parent then
            pcall(function() d.hl:Destroy(); d.bb:Destroy() end)
            brESP[m] = nil
        end
    end
end

