local function serverList()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
    local ok, res = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
    if not ok or type(res) ~= "table" or type(res.data) ~= "table" then return {} end
    return res.data
end
local function pickNextServer(visited)
    local best, bestN = nil, math.huge
    for _, s in ipairs(serverList()) do
        if s.id ~= game.JobId and not (visited and visited[s.id]) then
            local n  = tonumber(s.playing) or 99
            local mx = tonumber(s.maxPlayers) or 8
            if n < mx and n < bestN then best, bestN = s.id, n end
        end
    end
    return best
end
local HOPFILE = "VeniceHub_hop.json"
local function loadHop()
    local d
    if readfile then local ok, v = pcall(readfile, HOPFILE); if ok then d = v end end
    if not d or d == "" then return nil end
    local ok, t = pcall(HttpService.JSONDecode, HttpService, d)
    return (ok and type(t) == "table") and t or nil
end
local function saveHop(t)
    if not writefile then return end
    pcall(writefile, HOPFILE, t and HttpService:JSONEncode(t) or "")
end
local function bestInServer()
    local list = scanTargets(false)
    local best = nil
    for _, t in ipairs(list) do if not best or t.value > best.value then best = t end end
    return best, list
end
local function doHop(st)
    st = st or { auto = true, tries = 0, target = S.scanTarget, visited = {} }
    st.tries = (st.tries or 0) + 1
    st.visited = st.visited or {}
    st.visited[game.JobId] = true
    if st.tries > (S.hopMax or 45) then saveHop(nil); return false end
    local nxt = pickNextServer(st.visited)
    if not nxt then saveHop(nil); return false end
    saveHop(st)
    if queue_on_teleport then pcall(queue_on_teleport, LOADSTRING) end
    log("hopping -> " .. nxt .. " (" .. st.tries .. ")")
    task.wait(0.4)
    TeleportService:TeleportToPlaceInstance(game.PlaceId, nxt, LP)
    return true
end

--===================== GEAR AIM ===================================
local function equippedTool()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Tool")
end
local function toolWanted(name)
    if not name then return false end
    local n = name:lower()
    for w in S.gearNames:gmatch("[^,%s]+") do
        if n:find(w, 1, true) then return true end
    end
    return false
end
local function nearestPlayer(range)
    local hrp = getHRP(); if not hrp then return nil, math.huge end
    local best, bestD = nil, range or 60
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local d = (h.Position - hrp.Position).Magnitude
                if d < bestD then best, bestD = h, d end
            end
        end
    end
    return best, bestD
end
local lastGearFire = 0
local function gearTick(dt)
    if not S.gearAim then return end
    local tool = equippedTool()
    if not tool or not toolWanted(tool.Name) then return end
    local hrp = getHRP(); if not hrp then return end
    local target, dist = nearestPlayer(S.gearRange)
    if not target then return end
    local flat = Vector3.new(target.Position.X, hrp.Position.Y, target.Position.Z)
    if (flat - hrp.Position).Magnitude > 0.2 then
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.lookAt(hrp.Position, flat), math.clamp(S.gearSmooth * 60 * dt, 0, 1))
    end
    if S.gearAutoFire and dist <= S.gearRange and (os.clock() - lastGearFire) > S.gearFireCd then
        lastGearFire = os.clock()
        pcall(function() tool:Activate() end)
    end
end

