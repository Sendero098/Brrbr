    local ok, inst = pcall(Instance.new, class)
    if not ok or not inst then return nil end
    for k, v in pairs(props or {}) do pcall(function() inst[k] = v end) end
    if parent then pcall(function() inst.Parent = parent end) end
    return inst
end
