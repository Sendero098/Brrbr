    pcall(gearTick, dt)
end))

task.spawn(function()
    while alive() do
        task.wait(3)
        if S.espBrainrots then pcall(refreshBrainrotESP) end
        if S.lockSpeed then
            local h = getHum()
            if h and math.abs(h.WalkSpeed - S.walkSpeed) > 0.5 then h.WalkSpeed = S.walkSpeed end
        end
    end
end)

