local LOGF = "VeniceHub_log.txt"

local function log(s)
    local line = os.date("%H:%M:%S") .. "  " .. tostring(s)
    pcall(print, "[VH] " .. line)
    if not writefile then return end
    local prev = ""
    if readfile then local ok, d = pcall(readfile, LOGF); if ok and d then prev = d end end
    local t = {}
    for l in prev:gmatch("[^\n]+") do table.insert(t, l) end
    table.insert(t, line)
    while #t > 120 do table.remove(t, 1) end
    pcall(writefile, LOGF, table.concat(t, "\n"))
end

