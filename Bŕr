local flyBV, flyConn, flyUpDir = nil, nil, 0
local function stopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyBV then flyBV:Destroy(); flyBV = nil end
end
local function startFly()
    local hrp = getHRP(); if not hrp then return end
    flyBV = mk("BodyVelocity", { MaxForce = Vector3.new(1e5,1e5,1e5), P = 1e4, Parent = hrp })
    flyConn = RunService.RenderStepped:Connect(function()
        local h = getHRP(); local hum = getHum()
        if not h or not flyBV then return end
        local dir = hum and hum.MoveDirection or Vector3.zero
        flyBV.Velocity = (dir * S.flySpeed) + Vector3.new(0, flyUpDir * S.flySpeed, 0)
    end)
end

local stealThread
local function startAutoSteal()
    if stealThread then return end
    stealThread = task.spawn(function()
        while S.autoSteal do
            local ok, err = pcall(function()
                local t = scanTargets(false)[1]
                if t then
                    local hrp = getHRP()
                    if hrp then
                        local back = hrp.CFrame
                        tpTo(t.pos, 4)
                        task.wait(0.10)
                        firePrompt(t.prompt)
                        task.wait(S.stealDelay)
                        if S.returnToBase then tpTo(back.Position, 0) end
                    end
                else
                    task.wait(0.35)
                end
            end)
            if not ok then warn("[VeniceHub] steal: " .. tostring(err)) end
            task.wait(0.05)
        end
        stealThread = nil
    end)
end

