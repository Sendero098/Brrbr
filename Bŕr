local BYP = {
    hooked   = setmetatable({}, { __mode = "k" }),  -- [origfn] = true
    tagged   = setmetatable({}, { __mode = "k" }),  -- [connection] = true
    connMt   = nil,
    tagCount = 0,
    armed    = 0,
}
local obsReady = false

-- neuter Disconnect only for connections observeTag handed out
local function hookConnMt()
    if BYP.connMt then return true end
    if not (getrawmetatable and hookfunction and newcclosure) then return false end
    local ok = pcall(function()
        local probe = game:GetService("RunService").Heartbeat:Connect(function() end)
        local mt = getrawmetatable(probe)
        if not mt then return end
        if setreadonly then pcall(setreadonly, mt, false) end
        local idx = rawget(mt, "__index")
        if type(idx) ~= "table" then pcall(function() probe:Disconnect() end); return end
        if setreadonly then pcall(setreadonly, idx, false) end
        local od = rawget(idx, "Disconnect")
        if type(od) == "function" then
            rawset(idx, "Disconnect", newcclosure(function(self, ...)
                if BYP.tagged[self] then return end
                return od(self, ...)
            end))
            local odl = rawget(idx, "disconnect")
            if type(odl) == "function" then
                rawset(idx, "disconnect", newcclosure(function(self, ...)
                    if BYP.tagged[self] then return end
                    return odl(self, ...)
                end))
            end
            BYP.connMt = idx
        end
        pcall(function() probe:Disconnect() end)
    end)
    return BYP.connMt ~= nil
end

local function hookObserveTag()
    if not (getgc and hookfunction and newcclosure) then return 0 end
    if not BYP.connMt then hookConnMt() end
    local n = 0
    pcall(function()
        for _, v in pairs(getgc(true)) do
            local fn
            if type(v) == "table" then
                local f = rawget(v, "observeTag")
                if type(f) == "function" then fn = f end
            elseif type(v) == "function" then
                local ok, info = pcall(debug.getinfo, v)
                if ok and info and info.name == "observeTag" then fn = v end
            end
            if fn and not BYP.hooked[fn] then
                local old
                local ok2, ret = pcall(hookfunction, fn, newcclosure(function(...)
                    local conn = old(...)
                    if conn then
                        BYP.tagCount = BYP.tagCount + 1
                        if BYP.connMt then
                            BYP.tagged[conn] = true
                            return conn
                        end
                        return setmetatable({
                            Connected = true,
                            Disconnect = function() end,
                            disconnect = function() end,
                        }, { __index = function(_, k) return conn[k] end })
                    end
                    return conn
                end))
                if ok2 then
                    old = ret
                    BYP.hooked[fn] = true
                    n = n + 1
                end
            end
        end
    end)
    if n > 0 then
        BYP.armed = BYP.armed + n
        obsReady = true
        gv().VH_OBS = true
        log("bypass: observeTag hooked x" .. tostring(n) .. "  connMt=" .. tostring(BYP.connMt ~= nil))
    end
    return n
end

