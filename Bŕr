local function diagnose()
    local L = {}
    local function out(s) table.insert(L, s) end

    out("=== VENICE HUB DIAG v2.3 ===")
    out("time      = " .. os.date("%H:%M:%S"))
    out("place     = " .. tostring(game.PlaceId) .. "  ver=" .. tostring(game.PlaceVersion))
    out("job       = " .. tostring(game.JobId))
    out("executor  = hookfunction:" .. tostring(hookfunction ~= nil)
        .. " getgc:" .. tostring(getgc ~= nil)
        .. " fireprompt:" .. tostring(fireproximityprompt ~= nil)
        .. " gethui:" .. tostring(gethui ~= nil)
        .. " writefile:" .. tostring(writefile ~= nil)
        .. " queue:" .. tostring(queue_on_teleport ~= nil))
    out("anticheat = hooked:" .. acHooked .. " scans:" .. acScans
        .. " mode:" .. S.acMode .. " kickhook:" .. tostring(kickHookDone))
    out("kicks     = " .. kickCount .. "  swallowed:" .. swallowed .. "  last: " .. lastKick)
    out("gui parent= " .. (GUI and GUI.Parent and GUI.Parent:GetFullName() or "none"))
    out("mode      = legitPrompt:" .. tostring(S.legitPrompt)
        .. " instantPrompts:" .. tostring(S.instantPrompts) .. " tpOnly:" .. tostring(S.tpOnly))

    out("--- world ---")
    out("workspace kids = " .. #Workspace:GetChildren())
    local plots = getPlots()
    out("plots = " .. #plots)
    local my = getMyPlot()
    out("my plot = " .. (my and my:GetFullName() or "NOT FOUND"))
    out("base drop = " .. tostring(getBaseDrop()))
    out("lock btn  = " .. (findLockButton() and findLockButton():GetFullName() or "NOT FOUND"))

    out("--- targets ---")
    local targets = scanTargets(false)
    out("stealable = " .. #targets)
    local hrp = getHRP()
    for i = 1, math.min(3, #targets) do
        local t = targets[i]
        local p = t.prompt
        out(string.format("T%d  %s", i, p:GetFullName()))
        out(string.format("   hold=%.2f  maxDist=%.1f  enabled=%s",
            p.HoldDuration, p.MaxActivationDistance, tostring(p.Enabled)))
        out(string.format("   action=%s  object=%s  value=%d", tostring(p.ActionText), tostring(p.ObjectText), t.value))
        if hrp then out(string.format("   dist=%.1f", (t.pos - hrp.Position).Magnitude)) end
        local kids = {}
        for _, c in ipairs(t.pod:GetChildren()) do table.insert(kids, c.Name .. "[" .. c.ClassName .. "]") end
        out("   podium kids = " .. table.concat(kids, ", "))
    end

    out("--- prev session kicks (persisted) ---")
    local prev = fsRead(KICKFILE)
    if prev and prev ~= "" then
        local i = 0
        for l in prev:gmatch("[^\n]+") do
            i = i + 1
            if i > 12 then break end
            out("  " .. l)
        end
    else
        out("(none)")
    end
    out("=== END ===")
    return L
end

local function deepDump()
    local L = {}
    local function out(s) table.insert(L, s) end
    out("=== VENICE HUB DEEP DUMP v2.3 ===")
    out("place=" .. tostring(game.PlaceId) .. " job=" .. tostring(game.JobId))

    out("--- leaderstats ---")
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do out("  " .. v.Name .. " = " .. tostring(v.Value)) end
    else out("  (none)") end

    out("--- backpack tools ---")
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then out("  TOOL " .. t.Name) end
        end
    end
    local ch = LP.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then out("  EQUIPPED " .. t.Name) end
        end
    end

    out("--- gui buttons (candidates for lock/rebirth) ---")
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        local n = 0
        for _, d in ipairs(pg:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
                n = n + 1
                if n <= 40 then
                    out(string.format("  %s [%s] text=%q", d:GetFullName(), d.ClassName, tostring(d.Text)))
                end
            end
        end
    end

    out("--- first target podium detail ---")
    local t = scanTargets(false)[1]
    if t then
        out("  prompt " .. t.prompt:GetFullName())
        for k, v in pairs(t.prompt:GetAttributes()) do out("    P.attr " .. k .. " = " .. tostring(v)) end
        out("  podium " .. t.pod:GetFullName())
        for k, v in pairs(t.pod:GetAttributes()) do out("    O.attr " .. k .. " = " .. tostring(v)) end
        out("  descendants:")
        local n = 0
        for _, d in ipairs(t.pod:GetDescendants()) do
            n = n + 1
            if n > 60 then out("    ...") break end
            local attrs = {}
            for k, v in pairs(d:GetAttributes()) do table.insert(attrs, k .. "=" .. tostring(v)) end
            out(string.format("    %s [%s] %s", d:GetFullName(), d.ClassName, table.concat(attrs, " ")))
        end
    else
        out("  (no target in this server)")
    end

    out("--- all brainrot names currently in server ---")
    local names = {}
    for _, plot in ipairs(getPlots()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, pod in ipairs(podiums:GetChildren()) do
                local p = getPrompt(pod)
                if p and p.ObjectText ~= "" then table.insert(names, p.ObjectText) end
            end
        end
    end
    out("  " .. (#names > 0 and table.concat(names, ", ") or "(none)"))
    out("=== END DUMP ===")
    return table.concat(L, "\n")
end

local function runDiagnose()
    local ok, L = pcall(diagnose)
    if not ok then
        if diagLabel then diagLabel.Text = "diagnose error:\n" .. tostring(L) end
        return
    end
    local txt = table.concat(L, "\n")
    if diagLabel then diagLabel.Text = txt end
    if statusLbl then statusLbl.Text = "diag: " .. #L .. " lines (copied)" end
    pcall(function() if setclipboard then setclipboard(txt) end end)
    return txt
end

local function runDump()
    local ok, txt = pcall(deepDump)
    if not ok then if diagLabel then diagLabel.Text = "dump error: " .. tostring(txt) end return end
    if diagLabel then diagLabel.Text = txt end
    if statusLbl then statusLbl.Text = "deep dump copied (" .. #txt .. " chars)" end
    pcall(function() if setclipboard then setclipboard(txt) end end)
end

