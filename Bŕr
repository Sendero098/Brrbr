end))

local cashAcc = 0
local function getCash()
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            local n = v.Name:lower()
            if v:IsA("ValueBase") and (n:find("cash") or n:find("money") or n:find("coin")) then
                return v.Value
            end
        end
        local first = ls:FindFirstChildWhichIsA("ValueBase")
        if first then return first.Value end
    end
    for _, a in ipairs({ "Cash", "Money", "Coins" }) do
        local v = LP:GetAttribute(a)
        if typeof(v) == "number" then return v end
    end
    return nil
end
bind(RunService.Heartbeat:Connect(function(dt)
    cashAcc = cashAcc + dt
    if cashAcc < 0.5 then return end
    cashAcc = 0
    local c = getCash()
    cashLbl.Text = c and ("$" .. tostring(c)) or ""
end))

