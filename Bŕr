end

local function getPromptAnchor(prompt)
    local par = prompt and prompt.Parent
    if not par then return nil end
    if par:IsA("Attachment") then return par.WorldPosition end
    if par:IsA("BasePart") then return par.Position end
    local bp = par:FindFirstChildWhichIsA("BasePart", true)
    return bp and bp.Position or nil
end

local myPlotCache, myPlotTick = nil, 0
local function isMyPlot(plot)
    local yb = plot:FindFirstChild("YourBase", true)
    if yb then
        if yb:IsA("BoolValue") then
            if yb.Value then return true end
        elseif yb:IsA("GuiObject") or yb:IsA("Highlight") or yb:IsA("BillboardGui") then
            if yb.Enabled then return true end
        end
    end
    for _, a in ipairs({ "Owner", "Player", "UserId", "Plr", "Username" }) do
        local v = plot:GetAttribute(a)
        if v ~= nil and (v == LP.Name or v == LP.UserId or tostring(v) == tostring(LP.UserId)) then return true end
    end
    if plot.Name:find(LP.Name, 1, true) then return true end
    local n = 0
    for _, d in ipairs(plot:GetDescendants()) do
        n = n + 1
        if d:IsA("TextLabel") and d.Text == LP.Name then return true end
        if n > 250 then break end
    end
    return false
end

local function getMyPlot()
    if myPlotCache and myPlotCache.Parent and (os.clock() - myPlotTick) < 3 then return myPlotCache end
    myPlotCache, myPlotTick = nil, os.clock()
    for _, plot in ipairs(getPlots()) do
        if isMyPlot(plot) then myPlotCache = plot; break end
    end
    return myPlotCache
end

local function getBaseDrop()
    local my = getMyPlot()
    if not my then return nil end
    local hit = my:FindFirstChild("DeliveryHitbox", true)
    if hit and hit:IsA("BasePart") then return hit.Position end
    local any = my:FindFirstChildWhichIsA("BasePart", true)
    return any and any.Position or nil
end

-- FIXED: the brainrot lives inside the podium's "Claim" model.
-- v2.2 searched pod children for the first Model -> always returned Claim.
local function findBrainrotModel(pod)
    local claim = pod:FindFirstChild("Claim")
    if claim then
        local m = claim:FindFirstChildWhichIsA("Model")
        if m then return m end
        local p = claim:FindFirstChildWhichIsA("BasePart")
        if p then return p end
    end
    local base  = pod:FindFirstChild("Base")
    local spawn = base and (base:FindFirstChild("Spawn") or base:FindFirstChild("SpawnPoint"))
    local cont  = spawn or base
    if cont then
        local m = cont:FindFirstChildWhichIsA("Model")
        if m then return m end
    end
    return nil
end

local function getPrompt(pod)
    local base  = pod:FindFirstChild("Base")
    local spawn = base and (base:FindFirstChild("Spawn") or base:FindFirstChild("SpawnPoint"))
    local att   = spawn and spawn:FindFirstChild("PromptAttachment")
    local p     = att and att:FindFirstChild("ProximityPrompt")
    if p then return p end
    return pod:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function getPos(pod)
    local m = findBrainrotModel(pod)
    if m then
        local bp = m:IsA("BasePart") and m or m:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp.Position end
    end
    local bp = pod:FindFirstChildWhichIsA("BasePart", true)
    return bp and bp.Position or nil
end

local VALUE_KEYS = {
    value=true, price=true, cost=true, worth=true, income=true, money=true, cash=true,
    earnings=true, valuepersecond=true, multiplier=true, brainrotvalue=true, basevalue=true,
}
local function getValue(inst)
    for k, v in pairs(inst:GetAttributes()) do
        if typeof(v) == "number" and VALUE_KEYS[k:lower()] then return v end
    end
    for _, c in ipairs(inst:GetChildren()) do
        if c:IsA("ValueBase") and typeof(c.Value) == "number" then return c.Value end
        for k, v in pairs(c:GetAttributes()) do
            if typeof(v) == "number" and VALUE_KEYS[k:lower()] then return v end
        end
    end
    return 0
end

local function scanTargets(includeMine)
    local my = getMyPlot()
    local out = {}
    for _, plot in ipairs(getPlots()) do
        if includeMine or plot ~= my then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, pod in ipairs(podiums:GetChildren()) do
                    local prompt = getPrompt(pod)
                    if prompt and prompt.Enabled ~= false then
                        local body = findBrainrotModel(pod)
                        if (not S.requireBody) or body then
                            local val = getValue(pod) + (body and getValue(body) or 0)
                            if val >= (S.minValue * 1e6) then
                                local pos = getPromptAnchor(prompt) or getPos(pod)
                                if pos then
                                    table.insert(out, {
                                        pod = pod, prompt = prompt, value = val, pos = pos,
                                        name = (prompt.ObjectText ~= "" and prompt.ObjectText) or (body and body.Name) or "?",
                                        plot = plot, body = body,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if S.richestFirst then table.sort(out, function(a, b) return a.value > b.value end) end
    return out
end

--===================== PROMPT FIRING ==============================
local lastFired = setmetatable({}, { __mode = "k" })

local function inRange(p)
    local hrp = getHRP(); if not hrp then return false end
    local anchor = getPromptAnchor(p)
    if not anchor then return true end
    local maxd = tonumber(p.MaxActivationDistance) or 10
    return (hrp.Position - anchor).Magnitude <= maxd * (S.maxRangeFrac or 0.9)
end

local function firePrompt(p, force)
    if not p or not p.Parent or p.Enabled == false then return false end
    local now = os.clock()
    if not force and lastFired[p] and (now - lastFired[p]) < S.fireCooldown then return false end
    if not inRange(p) then return false end
    lastFired[p] = now

    local hold = tonumber(p.HoldDuration) or 0
    if S.legitPrompt and hold > 0 then
        local ok = pcall(function() p:InputHoldBegin() end)
        if ok then
            task.wait(hold + 0.05)
            pcall(function() p:InputHoldEnd() end)
            task.wait(0.03)
            return true
        end
    end
    if fireproximityprompt then
        if pcall(fireproximityprompt, p) then return true end
    end
    local ok2 = pcall(function() p:InputHoldBegin(); task.wait(0.06); p:InputHoldEnd() end)
    return ok2
end

--===================== STEAL ======================================
local function doSteal(t)
    if not t or not t.prompt or not t.prompt.Parent then return false end
    local hrp = getHRP(); if not hrp then return false end
    local startPos = hrp.Position
    local anchor = t.pos
    if not anchor then return false end

    if not inRange(t.prompt) then
        tpTo(anchor, 2)
        task.wait(S.settleTime)
    end

    if not S.tpOnly then
        local ok = firePrompt(t.prompt)
        if not ok then
            tpTo(anchor, 1.5); task.wait(0.12)
            ok = firePrompt(t.prompt, true)
        end
        if S.verify then
            task.wait(S.holdTime)
            local still = t.prompt.Parent and t.prompt.Enabled ~= false
            if still and S.retryOnce then
                task.wait(0.12)
                firePrompt(t.prompt, true)
            end
        end
    end

    task.wait(S.holdTime)
    if S.returnToBase then
        local dest = S.baseReturn and getBaseDrop() or startPos
        if dest then tpTo(dest, 3) end
    end
    task.wait(S.stealDelay)
    return true
end

local stealThread
local function startAutoSteal()
    if stealThread then return end
    stealThread = task.spawn(function()
        while S.autoSteal and alive() do
            local ok, err = pcall(function()
                local t = scanTargets(false)[1]
                if t then doSteal(t) else task.wait(0.4) end
            end)
            if not ok then warn("[VeniceHub] steal: " .. tostring(err)) end
            task.wait(0.05)
        end
        stealThread = nil
    end)
end

