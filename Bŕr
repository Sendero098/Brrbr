end
local brESP, plrESP = {}, {}
local ESP_FILL = Color3.fromRGB(150, 110, 255)
local ESP_GOOD = Color3.fromRGB(60, 230, 150)

local function makeBrainrotESP(model, name)
    if brESP[model] then return end
    local part = model:IsA("BasePart") and model or model:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    local hl = mk("Highlight", {
        FillColor = ESP_FILL, OutlineColor = ESP_FILL, FillTransparency = 0.65,
        OutlineTransparency = 0.15, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, ensureEspFolder())
    local bb = mk("BillboardGui", {
        Size = UDim2.new(0, 150, 0, 34), StudsOffset = Vector3.new(0, 3, 0),
        AlwaysOnTop = true, MaxDistance = 1000,
    }, part)
    local txt = mk("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = name or model.Name,
        TextColor3 = Color3.new(1,1,1), Font = Enum.Font.GothamBold, TextSize = 12,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0,0,0),
    }, bb)
    brESP[model] = { hl = hl, bb = bb, txt = txt }
end
local function clearBrainrotESP()
    for _, d in pairs(brESP) do pcall(function() d.hl:Destroy(); d.bb:Destroy() end) end
    brESP = {}
end
local function refreshBrainrotESP()
    local live = {}
    local my = getMyPlot()
    for _, plot in ipairs(getPlots()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, pod in ipairs(podiums:GetChildren()) do
                local prompt = getPrompt(pod)
                local model = prompt and findBrainrotModel(pod)
                if model then
                    live[model] = true
                    makeBrainrotESP(model, prompt.ObjectText)
                    local d = brESP[model]
                    if d then
                        if d.hl.Parent ~= ensureEspFolder() then d.hl.Parent = ensureEspFolder() end
                        local val = getValue(pod) + getValue(model)
                        d.txt.Text = string.format("%s\n%s  %s", prompt.ObjectText,
                            (plot == my) and "MINE" or "STEAL",
                            val > 0 and ("$" .. tostring(math.floor(val))) or "")
                        d.txt.TextColor3 = (plot == my) and ESP_GOOD or Color3.new(1,1,1)
