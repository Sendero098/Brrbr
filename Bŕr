--===================== FILE HELPERS ===============================
local function fsRead(p)
    if not readfile then return nil end
    local ok, d = pcall(function()
        if isfile and not isfile(p) then return nil end
        return readfile(p)
    end)
    return ok and d or nil
end
local function fsWrite(p, txt)
    if writefile then pcall(writefile, p, txt) end
end
local function fsAppend(p, line)
    if not writefile then return end
    local prev = fsRead(p) or ""
    local lines = {}
    for l in prev:gmatch("[^\n]+") do table.insert(lines, l) end
    table.insert(lines, line)
    while #lines > 70 do table.remove(lines, 1) end
    fsWrite(p, table.concat(lines, "\n"))
end

--===================== KICK FORENSICS =============================
local function noteKick(tag, msg, tb)
    kickCount = kickCount + 1
    lastKick  = tostring(msg)
    local stamp = os.date("%Y-%m-%d %H:%M:%S")
    local head = string.format("[%s] %s | %s | place=%s job=%s",
        stamp, tag, lastKick, tostring(game.PlaceId), tostring(game.JobId))
    table.insert(kickLog, head)
    if tb and tb ~= "" then table.insert(kickLog, "   caller: " .. tb) end
    while #kickLog > 40 do table.remove(kickLog, 1) end
    fsAppend(KICKFILE, head)
    if tb and tb ~= "" then fsAppend(KICKFILE, "   caller: " .. tb) end
    pcall(print, "[VeniceHub][KICK] " .. head)
    if tb and tb ~= "" then pcall(print, "[VeniceHub][CALLER] " .. tb) end
    if statusLbl then statusLbl.Text = "KICK(" .. kickCount .. "): " .. lastKick end
end

local function trace()
    local ok, t = pcall(debug.traceback, "", 3)
    if not ok or not t then return "" end
    t = t:gsub("\n", " >> "):gsub("%s+", " ")
    if #t > 400 then t = t:sub(1, 400) .. "..." end
    return t
end

local kickHookDone = false
local function installKickHook()
    if kickHookDone or not hookfunction then return false end
    local wrap = newcclosure or function(f) return f end
    local ok = pcall(function()
        local old
        old = hookfunction(LP.Kick, wrap(function(self, msg)
            noteKick("LP.Kick", msg, trace())
            if S.swallow then
                swallowed = swallowed + 1
                if S.rejoinOnKick then
                    task.delay(0.4, function()
                        pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
                    end)
                else
                    -- re-arm: AC may have replaced our hooks during its kick
                    task.delay(0.6, function()
                        pcall(function() if old then hookfunction(LP.Kick, LP.Kick) end end)
                        if S.antiCheat then task.spawn(acScanOnce) end
                    end)
                end
                return
            end
            if old then return old(self, msg) end
        end))
    end)
    kickHookDone = ok
    return ok
end

--===================== AC BYPASS ==================================
local acHooked, acScans = 0, 0
local acSeen = setmetatable({}, { __mode = "k" })   -- weak keys, no leak

local function acStub()
    local wrap = newcclosure or function(f) return f end
    return wrap(function()
        return { Disconnect = function() end, disconnect = function() end, Connected = true }
    end)
end

function acScanOnce()
    if not (getgc and hookfunction) then return end
    if S.acMode == "off" then return end
    local wrap = newcclosure or function(f) return f end
    local stub = acStub()
    local kill = (S.acMode == "kill")
    local gc = getgc(true)
    for _, v in pairs(gc) do
        if type(v) == "table" and acSeen[v] == nil then
            local fn = rawget(v, "observeTag")
            if type(fn) == "function" then
                acSeen[v] = true
                local done = false
                if kill then
                    -- variant B: immediately tear the watcher down
                    local ok = pcall(hookfunction, fn, wrap(function(...)
                        local conn = fn(...)
                        pcall(function() if conn and conn.Disconnect then conn.Disconnect(conn) end end)
                        return conn
                    end))
                    done = ok
                else
                    done = pcall(hookfunction, fn, stub)
                end
                if done then acHooked = acHooked + 1 end
            end
        end
    end
end

local acThread
local function startAntiCheatBypass()
    if acThread then return end
    acThread = task.spawn(function()
        local t0 = os.clock()
        while S.antiCheat and alive() do
            acScans = acScans + 1
            pcall(acScanOnce)
            if os.clock() - t0 > 30 then task.wait(3) else task.wait(0.15) end
        end
        acThread = nil
    end)
end

