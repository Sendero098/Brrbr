local myPlotCache, myPlotTick = nil, 0
local function isMyPlot(plot)
    local yb = plot:FindFirstChild("YourBase", true)
    if yb then
        if yb:IsA("BoolValue") then
            if yb.Value then return true end
        elseif yb:IsA("GuiObject") or yb:IsA("Highlight") or yb:IsA("BillboardGui") then
            if yb.Enabled then return true end
        end
    end
    for _, a in ipairs({ "Owner", "Player", "UserId", "Plr", "Username" }) do
        local v = plot:GetAttribute(a)
        if v ~= nil and (v == LP.Name or v == LP.UserId or tostring(v) == tostring(LP.UserId)) then
            return true
        end
    end
    if plot.Name:find(LP.Name, 1, true) then return true end
    local n = 0
    for _, d in ipairs(plot:GetDescendants()) do
        n = n + 1
        if d:IsA("TextLabel") and d.Text == LP.Name then return true end
        if n > 250 then break end
    end
    return false
end

local function getMyPlot()
    if myPlotCache and myPlotCache.Parent and (os.clock() - myPlotTick) < 3 then
        return myPlotCache
    end
    myPlotCache, myPlotTick = nil, os.clock()
    for _, plot in ipairs(getPlots()) do
        if isMyPlot(plot) then myPlotCache = plot; break end
    end
    return myPlotCache
end

local function findBrainrotModel(pod)
    local base  = pod:FindFirstChild("Base")
    local spawn = base and (base:FindFirstChild("Spawn") or base:FindFirstChild("SpawnPoint"))
    local cont  = spawn or base or pod
    for _, c in ipairs(cont:GetChildren()) do
        if c:IsA("Model") then return c end
    end
    for _, c in ipairs(cont:GetChildren()) do
        if c:IsA("BasePart") and c.Name ~= "PromptAttachment" then return c end
    end
    for _, c in ipairs(cont:GetChildren()) do
        if c:IsA("Folder") then return c end
    end
    return nil
end

local function getPrompt(pod)
    local base  = pod:FindFirstChild("Base")
    local spawn = base and (base:FindFirstChild("Spawn") or base:FindFirstChild("SpawnPoint"))
    local att   = spawn and spawn:FindFirstChild("PromptAttachment")
    local p     = att and att:FindFirstChild("ProximityPrompt")
    if p then return p end
    return pod:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function getValue(inst)
    for k, v in pairs(inst:GetAttributes()) do
        if typeof(v) == "number" and VALUE_KEYS[k:lower()] then return v end
    end
    for _, c in ipairs(inst:GetChildren()) do
        for k, v in pairs(c:GetAttributes()) do
            if typeof(v) == "number" and VALUE_KEYS[k:lower()] then return v end
        end
    end
    return 0
end

local function getPos(pod)
    local m = findBrainrotModel(pod)
    if m then
        local bp = m:IsA("BasePart") and m or m:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp.Position end
    end
    local bp = pod:FindFirstChildWhichIsA("BasePart", true)
    return bp and bp.Position or nil
end

local function scanTargets(includeMine)
    local my = getMyPlot()
    local out = {}
    for _, plot in ipairs(getPlots()) do
        if includeMine or plot ~= my then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, pod in ipairs(podiums:GetChildren()) do
                    local prompt = getPrompt(pod)
                    if prompt then
                        local val = getValue(pod)
                        if val >= (S.minValue * 1e6) then
                            local pos = getPos(pod)
                            if pos then
                                table.insert(out, { pod = pod, prompt = prompt, value = val, pos = pos })
                            end
                        end
                    end
                end
            end
        end
    end
    if S.richestFirst then
        table.sort(out, function(a, b) return a.value > b.value end)
    end
    return out
end

local espFolder = mk("Folder", { Name = "VeniceESP" }, Workspace)
local brESP, plrESP = {}, {}
local ESP_FILL = Color3.fromRGB(150, 110, 255)
local ESP_GOOD = Color3.fromRGB(60, 230, 150)

local function makeBrainrotESP(model)
    if brESP[model] then return end
    local part = model:IsA("BasePart") and model or model:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    local hl = mk("Highlight", {
        FillColor = ESP_FILL, OutlineColor = ESP_FILL,
        FillTransparency = 0.65, OutlineTransparency = 0.15,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, model)
    local bb = mk("BillboardGui", {
        Size = UDim2.new(0, 130, 0, 34), StudsOffset = Vector3.new(0, 3, 0),
        AlwaysOnTop = true, MaxDistance = 1000,
    }, part)
    local txt = mk("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = model.Name, TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.GothamBold, TextSize = 12,
        TextStrokeTransparency = 0.4, TextStrokeColor3 = Color3.new(0,0,0),
    }, bb)
    brESP[model] = { hl = hl, bb = bb, txt = txt }
end

local function clearBrainrotESP()
    for _, d in pairs(brESP) do
        pcall(function() d.hl:Destroy(); d.bb:Destroy() end)
    end
    brESP = {}
end

local function refreshBrainrotESP()
    local live = {}
    local my = getMyPlot()
    for _, plot in ipairs(getPlots()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, pod in ipairs(podiums:GetChildren()) do
                if getPrompt(pod) then
                    local model = findBrainrotModel(pod)
                    if model then
                        live[model] = true
                        makeBrainrotESP(model)
                        local d = brESP[model]
                        if d then
                            local val = getValue(pod)
                            local tag = (plot == my) and "MINE" or "STEAL"
                            d.txt.Text = string.format("%s\n%s  %s", model.Name, tag,
                                val > 0 and ("$" .. tostring(math.floor(val))) or "")
                            d.txt.TextColor3 = (plot == my) and ESP_GOOD or Color3.new(1,1,1)
                            d.hl.FillColor = (plot == my) and ESP_GOOD or ESP_FILL
                            d.hl.OutlineColor = d.hl.FillColor
                        end
                    end
                end
            end
        end
    end
    for m, d in pairs(brESP) do
        if not live[m] or not m.Parent then
            pcall(function() d.hl:Destroy(); d.bb:Destroy() end)
            brESP[m] = nil
        end
    end
end

